model User {
  id String @id @default(uuid())
  name String 
  email String @unique 
  password String
  activeStatus ActiveStatus @default(ACTIVE)
  role Role @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}



enum ActiveStatus {
 ACTIVE
  BLOCK
}

enum Role {
USER
ADMIN
AUTHOR
}